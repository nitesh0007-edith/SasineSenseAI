APP_ENV=dev
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
RENDER_DIR=./data/rendered
DERIVED_DIR=./data/derived
REVIEW_LOG_DIR=./data/derived/reviews

MAX_UPLOAD_MB=25
PDF_RENDER_DPI=150

# Providers (selected via factory; keep mock/local by default).
OCR_PROVIDER=mock            # mock | tesseract
NER_PROVIDER=spacy
STRUCTURED_EXTRACTION_PROVIDER=mock

# Image preprocessing (Phase 2). Non-destructive; off by default.
PREPROCESS_ENABLED=false
PREPROCESS_GRAYSCALE=true
PREPROCESS_NORMALIZE_CONTRAST=true
PREPROCESS_DESKEW=true
PREPROCESS_DENOISE=true
PREPROCESS_THRESHOLD=false

# Place resolution (Phase 9).
GAZETTEER_CSV=./data/gazetteer/sample_scotland_places.csv

# Real structured extraction via Mesh API (OpenAI-compatible gateway, Task 7.3).
# Set STRUCTURED_EXTRACTION_PROVIDER=mesh to activate. Never commit a real key.
STRUCTURED_API_BASE=https://api.meshapi.ai/v1
MESH_API_KEY=rsk_your_router_service_key_here
STRUCTURED_API_MODEL=anthropic/claude-sonnet-5
STRUCTURED_API_TIMEOUT=90

# Persistence. SQLite by default (zero-setup). For Postgres/PostGIS use e.g.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ros_ai
DATABASE_URL=sqlite:///./data/derived/app.db

REVIEW_HIGH_CONFIDENCE=0.90
REVIEW_MEDIUM_CONFIDENCE=0.70
